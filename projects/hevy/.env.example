# install.ps1 copies this file to .env. Fill in your key there, not here.
# Get your Hevy API key from: Hevy app → Settings → Developer / API
HEVY_API_KEY=your_hevy_api_key_here
EXCEL_PATH=C:\Users\viggo\OneDrive\Privat\Fitness\Træning.xlsx
EXCEL_SHEET=Træning
# Your bodyweight in kg. --weeks needs it to match the volume the Hevy app
# shows: Hevy loads pull-ups, chin-ups, dips and handstand push-ups with your
# bodyweight, but the API only sends the added plate. There is no endpoint for
# it, so it goes here. Left empty, those sets count as their plate alone.
HEVY_BODYWEIGHT_KG=
