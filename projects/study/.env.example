# install.ps1 copies this file to .env. The path below is already the default in
# study.ps1, so the tool works without a .env at all. Override here only if the
# Literature repo moves.
#
# This file belongs to the TOOL, not to the Literature repo: a config file living
# inside the target folder would be circular, since this path is what finds it.
STUDY_REPO=C:\Users\viggo\Git Clone\Literature
