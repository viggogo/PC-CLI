# install.ps1 copies this file to .env. Both paths below are already the defaults
# in study.ps1, so the tool works without a .env at all. Override here only if a
# repo moves.
#
# This file belongs to the TOOL, not to either repo: a config file living inside
# a target folder would be circular, since these paths are what find them.
STUDY_READ_REPO=C:\Users\viggo\Git Clone\Literature
STUDY_WRITE_REPO=C:\Users\viggo\Git Clone\latex
